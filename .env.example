# Contraseña para entrar al panel (larga y única)
DASHBOARD_PASSWORD=

# Clave para firmar la cookie de sesión, mínimo 32 caracteres. Cambiarla cierra todas las sesiones.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
DASHBOARD_SECRET=

# Fuente de las notas. En local, la carpeta de la bóveda (con barras normales).
# Las capturas del panel se escriben en su carpeta inbox/.
BOVEDA_DIR=

# En producción, el repo privado de notas. Token de GitHub con permisos finos:
# solo ese repo y "Contents: Read and write" (la captura rápida crea notas en inbox/).
# No definir BOVEDA_DIR en producción.
GITHUB_TOKEN=
GITHUB_REPO=usuario/repo-de-notas
GITHUB_BRANCH=main

# Token de SOLO LECTURA para los repos de código: estado, despliegues, pruebas, alertas de
# seguridad e incidencias de la vigilancia. Distinto de GITHUB_TOKEN, que escribe en las notas.
# Permisos finos, todos Read-only: Metadata, Contents, Pull requests, Commit statuses,
# Actions, Deployments, Dependabot alerts e Issues. Ver docs/vigilancia.md.
GITHUB_TOKEN_LECTURA=

# Secreto de /api/vigilancia, que consulta cada hora la acción de GitHub. 32 caracteres o más.
# El mismo valor va en el secreto VIGILANCIA_SECRET del repo. Sin él, la ruta responde 404.
VIGILANCIA_SECRET=

# Repo donde la vigilancia abre las incidencias (por defecto, este)
# VIGILANCIA_REPO=FacundoSierra/dashboard-fsmtech

# Documentos de los clientes: los archivos van a un almacén PRIVADO de Vercel Blob, conectado
# al proyecto en Vercel (añade BLOB_STORE_ID y se autentica con OIDC, sin claves). En local,
# una carpeta del PC para no tocar el almacén de verdad; si está definida, manda sobre Vercel Blob.
# No definirla en producción. Ver docs/documentos.md.
DOCUMENTOS_DIR=

# Entrar con huella o cara (passkeys). Lista de dispositivos registrados, en JSON.
# La escribe el propio panel: Ajustes -> Registrar este dispositivo, y se pega aquí.
# Vacía o mal escrita, solo se entra con la contraseña
PASSKEYS=

# Base de datos del panel (Supabase, proyecto `fsmtech`): hoy, la consultoría de OVB. Solo la lee el
# servidor, por lib/base/cliente.ts, detrás de verificarSesion(). SIN el prefijo NEXT_PUBLIC_: nada
# de la base llega al navegador.
# - SUPABASE_URL: https://<ref>.supabase.co (Project Settings -> API)
# - SUPABASE_SECRET_KEY: una clave secreta (sb_secret_...) de Project Settings -> API Keys -> Secret
#   keys. Una por sitio, para poder quitar una sin tocar la otra: `pc` aquí y `panel-vercel` en Vercel
#   (solo Production, nunca en Preview ni en Development). Nunca en GitHub ni en los secretos de Actions.
# Sin ellas, el panel arranca igual y la sección Consultoría dice que falta configurar la base.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
